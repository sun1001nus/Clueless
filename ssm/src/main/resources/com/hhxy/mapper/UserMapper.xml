<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhxy.mapper.UserMapper">
    <!-- 注册：插入用户 -->
    <insert id="insertUser" parameterType="com.hhxy.pojo.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(username, password, email)
        VALUES (#{username}, #{password}, #{email})
    </insert>

    <!-- 登录：根据用户名查用户 -->
    <select id="selectUserByUsername" parameterType="String" resultType="com.hhxy.pojo.User">
        SELECT * FROM user WHERE username = #{username}
    </select>
</mapper>