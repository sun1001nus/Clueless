<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hhxy.mapper.ItemMapper">
    <select id="queryItemList" resultType="item">
        select * from item ORDER BY id ASC
    </select>

    <insert id="addItem" parameterType="item">
        insert into item(name,price,details) values (#{name},#{price},#{details})
    </insert>

    <update id="updateItem" parameterType="item">
        update item set name=#{name},price=#{price},details=#{details} where id=#{id}
    </update>

    <select id="queryItemById" resultType="item" parameterType="int">
        select * from item where id =#{id}
    </select>

    <delete id="deleteItem" parameterType="int">
        delete from item where id=#{id}
    </delete>

    <!-- 模糊查询商品-->
    <select id="selectItemsByKeyword" parameterType="String" resultType="com.hhxy.pojo.Item">
        SELECT * FROM item
        WHERE name LIKE CONCAT('%', #{keyword}, '%')
           OR details LIKE CONCAT('%', #{keyword}, '%')
    </select>
</mapper>




